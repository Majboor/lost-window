#!/bin/zsh

set -euo pipefail

CLI_PATH="${1:-}"
shift || true

if [[ -z "$CLI_PATH" || ! -x "$CLI_PATH" ]]; then
  print -u2 "Missing executable lost-window path."
  exit 1
fi

TARGET_DIR="$HOME/Applications/Lost Window"

while (( $# > 0 )); do
  case "$1" in
    --target-dir)
      if (( $# < 2 )); then
        print -u2 "Missing value for --target-dir."
        exit 1
      fi
      TARGET_DIR="$2"
      shift 2
      ;;
    *)
      print -u2 "Unknown argument: $1"
      exit 1
      ;;
  esac
done

mkdir -p "$TARGET_DIR"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

build_app() {
  local app_name="$1"
  local command_name="$2"
  local script_path="$TMP_DIR/$app_name.applescript"
  local app_path="$TARGET_DIR/$app_name.app"

  cat > "$script_path" <<EOF
on run
  do shell script quoted form of "$CLI_PATH" & " $command_name"
end run
EOF

  rm -rf "$app_path"
  osacompile -o "$app_path" "$script_path" >/dev/null 2>&1
}

build_app "Force Show Lost Window" "choose"
build_app "Force Show Frontmost Window" "frontmost"

cat <<EOF
Installed launcher apps:
- $TARGET_DIR/Force Show Lost Window.app
- $TARGET_DIR/Force Show Frontmost Window.app

Use them in one of two ways:
- pin either app to the Dock for one-click access
- use the Shortcuts app with an "Open App" action, then assign a keyboard shortcut

If you launch the wrappers directly, make sure the generated app has Accessibility permission.
EOF
